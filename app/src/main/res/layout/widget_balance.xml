<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B4734"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="হিসাব-খাতা (Balance)"
            android:textColor="#C2EBD4"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/widget_btn_refresh"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="Refresh"
            android:src="@android:drawable/ic_popup_sync" />
    </LinearLayout>

    <!-- Main Balance Display -->
    <TextView
        android:id="@+id/widget_tv_balance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="৳ ০.০০"
        android:textColor="#FBFDFA"
        android:textSize="22sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="#2E6C54" />

    <!-- Income & Expense Sub-Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Today Income -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="আজকের আয়"
                android:textColor="#A0E5C0"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/widget_tv_income"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+৳ ০"
                android:textColor="#48DC8C"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Today Expense -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="আজকের ব্যয়"
                android:textColor="#F3B3B3"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/widget_tv_expense"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-৳ ০"
                android:textColor="#FF897D"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
