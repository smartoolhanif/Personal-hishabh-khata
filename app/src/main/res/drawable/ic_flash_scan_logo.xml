    <!-- Top-Left -->
    <path
        android:pathData="M 34,48 L 34,38 C 34,35 36.5,33 39.5,33 L 49.5,33"
        android:strokeWidth="4"
        android:strokeColor="#FF00E5FF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

