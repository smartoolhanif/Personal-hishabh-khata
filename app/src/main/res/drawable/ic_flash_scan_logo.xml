    <path
        android:pathData="M 33,57 L 87,57 L 87,63 L 33,63 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="33"
                android:startY="60"
                android:endX="87"
                android:endY="60"
                android:type="linear">
