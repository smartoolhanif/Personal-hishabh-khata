                android:startY="8"
                android:endX="120"
                android:endY="112"
                android:type="linear">
                <item android:color="#FF0D2244" android:offset="0.0" />
                <item android:color="#FF071326" android:offset="0.6" />
                <item android:color="#FF030914" android:offset="1.0" />
            </gradient>
