[debug] [2026-09-10T19:04:21.390Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/hisab-93d73/rulesets {"name":"projects/hisab-93d73/rulesets/53692757-1e1a-4e95-af55-ac475753864f","source":{"files":[{"content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    // User profile isolation\n    match /users/{userId} {\n      allow read, write: if request.auth != null && request.auth.uid == userId;\n\n      // Transactions subcollection isolation\n      match /transactions/{transactionId} {\n        allow read, write: if request.auth != null && request.auth.uid == userId;\n      }\n\n      // Categories subcollection isolation\n      match /categories/{categoryId} {\n        allow read, write: if request.auth != null && request.auth.uid == userId;\n      }\n\n      // Settings subcollection isolation\n      match /settings/{settingId} {\n        allow read, write: if request.auth != null && request.auth.uid == userId;\n      }\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-09-10T19:04:21.281823Z","metadata":{"services":["cloud.firestore"]}}
